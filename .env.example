# Root .env CHỈ dành cho Docker Compose. KHÔNG commit .env thực tế lên GitHub.
# Khi tái sử dụng volume cnpm-db-data cũ: PHẢI nhập đúng mật khẩu PostgreSQL cũ.
# Mật khẩu đặt trong DATABASE_URL phải dùng ký tự URL-safe (hoặc URL-encode ký tự đặc biệt).
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_EXISTING_DB_PASSWORD

# Tạo khoá ngẫu nhiên bằng PowerShell; không dùng giá trị ví dụ để triển khai công khai.
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Nếu quyền Admin đã có trong bảng users (role=admin), để trống.
ADMIN_USER_IDS=

# API này được nhúng khi build Expo Web, truy cập từ trình duyệt trên máy tính.
# Client trong repo có xử lý thay localhost bằng IP khi truy cập qua mạng LAN.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Chỉ tạo tài khoản demo ở môi trường development; seed chỉ chạy khi bảng users còn trống.
DEMO_ACCOUNTS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_GUEST_EMAIL=khach@example.com
DEMO_GUEST_PASSWORD=Khach@123
